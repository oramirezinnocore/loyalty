# ============================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# IntusPath Loyalty - Multi-tenant SaaS Platform
# ============================================

# ============================================
# DATABASE (REQUIRED)
# ============================================
DATABASE_URL="postgresql://username:password@localhost:5432/intus_loyalty?schema=public"
# Production: Use connection pooling (e.g., PgBouncer) for scalability
# Example: postgresql://user:pass@host:5432/db?pgbouncer=true&connection_limit=10

# ============================================
# AUTHENTICATION (REQUIRED)
# ============================================
NEXTAUTH_URL="https://yourdomain.com"
# REQUIRED: Generate secure secret with: openssl rand -base64 32
NEXTAUTH_SECRET="CHANGE-THIS-TO-SECURE-RANDOM-STRING"

# ============================================
# APPLICATION (REQUIRED)
# ============================================
NEXT_PUBLIC_APP_URL="https://yourdomain.com"
NODE_ENV="production"

# ============================================
# CRON/SCHEDULED TASKS (REQUIRED FOR BILLING)
# ============================================
# Generate with: openssl rand -hex 32
# Used by automated grace period enforcement
CRON_SECRET="your-secure-cron-secret-here"

# ============================================
# MERCADO PAGO (REQUIRED FOR BILLING)
# ============================================
# Get from: https://www.mercadopago.com.mx/developers/panel/app
MERCADO_PAGO_ACCESS_TOKEN="APP_USR-your-production-access-token"
# Webhook secret for signature validation (set in MP dashboard)
MERCADO_PAGO_WEBHOOK_SECRET="your-webhook-secret-from-mercadopago"

# Billing configuration
BILLING_GRACE_PERIOD_DAYS="3"

# ============================================
# GOOGLE WALLET (OPTIONAL - for Google Pay integration)
# ============================================
# Get from: https://console.cloud.google.com/
# Enable Google Wallet API and create service account
GOOGLE_WALLET_ISSUER_ID="3388000000022334455"
GOOGLE_WALLET_SERVICE_ACCOUNT_EMAIL="loyalty@your-project.iam.gserviceaccount.com"
# Service account private key (JSON format, newlines as \n)
GOOGLE_WALLET_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYourPrivateKeyHere\n-----END PRIVATE KEY-----"

# ============================================
# APPLE WALLET (OPTIONAL - for Apple Wallet integration)
# ============================================
# Get from: https://developer.apple.com/account/
# 1. Create Pass Type ID
# 2. Generate Pass Type ID Certificate
# 3. Download WWDR G4 Certificate
APPLE_PASS_TYPE_IDENTIFIER="pass.com.intus.loyalty"
APPLE_TEAM_IDENTIFIER="ABCD123456"
APPLE_PASS_CERTIFICATE="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
APPLE_PASS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
APPLE_WWDR_CERTIFICATE="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
APPLE_PASS_PRIVATE_KEY_PASSWORD=""

# ============================================
# MOCK MODE (DEVELOPMENT/TESTING ONLY - NEVER IN PRODUCTION)
# ============================================
# For local development without external credentials:
# MERCADO_PAGO_ACCESS_TOKEN="TEST-mock-access-token"
# GOOGLE_WALLET_PRIVATE_KEY="MOCK_PRIVATE_KEY"
# APPLE_PASS_CERTIFICATE="MOCK_CERTIFICATE"
#
# WARNING: These values will be rejected if NODE_ENV=production
